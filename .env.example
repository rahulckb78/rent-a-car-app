# MySQL connection URL. Required. Form: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
# Hosted providers (Aiven, TiDB Cloud, Railway, ...) need TLS: it is on automatically for any
# host that is not localhost. Aiven-style private CAs: set DB_SSL_VERIFY=false (or leave verification on if
# the provider's CA is public).
DATABASE_URL=mysql://user:password@mysql-example.aivencloud.com:12345/defaultdb
DB_SSL_VERIFY=true

# API port for local development (Angular's dev server runs on 4200 and proxies /api here).
PORT=8000

# Optional: extra browser origins allowed to make state-changing requests. The app's own origin is
# always allowed, so this is normally empty (see reference/learnings.md, "CSRF").
ALLOWED_ORIGINS=

# Session lifetime in days.
SESSION_DAYS=30

# Venue rules (booking archetype).
BUSINESS_TZ=Asia/Kolkata
SLOT_MINUTES=60
OPEN_HOUR=8
CLOSE_HOUR=20
MAX_SLOTS_PER_BOOKING=4
MAX_DAYS_AHEAD=60

